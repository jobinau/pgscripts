# Docker image under test. Bump to 19rcN / 19 when available.
PG_IMAGE=postgres:19beta4

# Dev-only credentials
POSTGRES_PASSWORD=postgres
REPL_PASSWORD=replpass

# Host ports
PRIMARY_PORT=5433
STANDBY_PORT=5434

# Initial primary WAL writer tuning (sets the floor of T2 latency, see CLAUDE.md).
# Applied with ALTER SYSTEM at initdb time; change later with scripts/set_wal_writer_delay.sh
WAL_WRITER_DELAY=200ms
WAL_WRITER_FLUSH_AFTER=1MB

# Where the standby finds the primary. Defaults to the compose service.
# On EC2 with separate hosts: PRIMARY_HOST=<primary private IP>, PRIMARY_REPL_PORT=5433
PRIMARY_HOST=pg19-primary
PRIMARY_REPL_PORT=5432
